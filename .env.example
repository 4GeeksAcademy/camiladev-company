# Generate a local value with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=replace-with-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL/Supabase URL required by the API.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Public address used in password reset links.
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Docker Compose service DNS name and internal port.
BACKEND_INTERNAL_URL=http://api:8000

# Public external API used by the candidates page at build time.
NEXT_PUBLIC_API_URL=https://playground.4geeksacademy.com/tracker/api/v1