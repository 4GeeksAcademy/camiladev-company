{
  "name": "camiladev-company",
  "private": true,
  "version": "1.0.0",
  "description": "Static web runtime scripts for the camiladev-company workspace",
  "scripts": {
    "dev": "npm --prefix public-website run dev -- --hostname 0.0.0.0 --port 3001",
    "build": "npm --prefix public-website run build",
    "start": "npm --prefix public-website run start -- --hostname 0.0.0.0",
    "check:routes": "node ./scripts/check-routes.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx src/utils/validations.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "http-server": "^14.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
